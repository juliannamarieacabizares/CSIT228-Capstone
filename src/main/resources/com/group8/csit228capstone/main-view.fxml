<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group8.csit228capstone.MainController">

    <!-- TOP HEADER -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #1a1a2e, #16213e);">
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <padding>
                    <Insets top="18.0" right="20.0" bottom="18.0" left="20.0" />
                </padding>
                <children>
                    <Label text="🎟️" style="-fx-font-size: 28.0px;" />
                    <Label text="Event Ticketing System" style="-fx-font-size: 20.0px; -fx-font-weight: bold; -fx-text-fill: white;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblWelcome" text="Welcome, User" style="-fx-text-fill: #a0a0c0;" />
                </children>
            </HBox>
        </VBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox spacing="8.0" style="-fx-background-color: #1e1e2f;">
            <padding>
                <Insets top="25.0" right="15.0" bottom="25.0" left="15.0" />
            </padding>
            <children>
                <Label text="MENU" style="-fx-text-fill: #6c6c8a; -fx-font-size: 11.0px; -fx-font-weight: bold;" />

                <Button fx:id="btnEvents" onAction="#handleEventsNavigation" style="-fx-background-color: #2d2d44; -fx-background-radius: 8; -fx-text-fill: white; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12.0;" text="📅  Events">
                    <font><Font size="13.0" /></font>
                </Button>

                <Button fx:id="btnView" onAction="#handleViewBookings" style="-fx-background-color: transparent; -fx-text-fill: #b0b0cc; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12.0;" text="📋  My Bookings">
                    <font><Font size="13.0" /></font>
                </Button>

                <Button fx:id="btnManageEvents" onAction="#handleManageEvents" style="-fx-background-color: transparent; -fx-text-fill: #b0b0cc; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12.0;" text="⚙️  Manage Events" visible="false" managed="false">
                    <font><Font size="13.0" /></font>
                </Button>

                <Separator style="-fx-background-color: #2d2d44;" />

                <Button fx:id="btnLogout" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #ff6b6b; -fx-alignment: CENTER_LEFT; -fx-graphic-text-gap: 12.0;" text="🚪  Logout">
                    <font><Font size="13.0" /></font>
                </Button>
            </children>
        </VBox>
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="20.0">
            <padding>
                <Insets top="20.0" right="25.0" bottom="20.0" left="25.0" />
            </padding>
            <children>
                <!-- Welcome message -->
                <Label fx:id="lblStatus" style="-fx-font-size: 18.0px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />

                <!-- Stats Cards -->
                <HBox spacing="20.0">
                    <children>
                        <VBox style="-fx-background-color: white; -fx-background-radius: 12.0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8.0, 0.0, 0.0, 2.0);" spacing="8.0" HBox.hgrow="ALWAYS">
                            <padding><Insets top="18.0" right="15.0" bottom="18.0" left="15.0" /></padding>
                            <Label text="📊" style="-fx-font-size: 28.0px;" />
                            <Label text="Total Events" style="-fx-text-fill: #888888; -fx-font-size: 12.0px;" />
                            <Label fx:id="lblTotalEvents" text="0" style="-fx-font-size: 28.0px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                        </VBox>
                        <VBox style="-fx-background-color: white; -fx-background-radius: 12.0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8.0, 0.0, 0.0, 2.0);" spacing="8.0" HBox.hgrow="ALWAYS">
                            <padding><Insets top="18.0" right="15.0" bottom="18.0" left="15.0" /></padding>
                            <Label text="🎫" style="-fx-font-size: 28.0px;" />
                            <Label text="Available Tickets" style="-fx-text-fill: #888888; -fx-font-size: 12.0px;" />
                            <Label fx:id="lblAvailableTickets" text="0" style="-fx-font-size: 28.0px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                        </VBox>
                        <VBox style="-fx-background-color: white; -fx-background-radius: 12.0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8.0, 0.0, 0.0, 2.0);" spacing="8.0" HBox.hgrow="ALWAYS">
                            <padding><Insets top="18.0" right="15.0" bottom="18.0" left="15.0" /></padding>
                            <Label text="📅" style="-fx-font-size: 28.0px;" />
                            <Label text="Upcoming Events" style="-fx-text-fill: #888888; -fx-font-size: 12.0px;" />
                            <Label fx:id="lblUpcomingEvents" text="0" style="-fx-font-size: 28.0px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                        </VBox>
                    </children>
                </HBox>

                <!-- Events Table with Refresh Button and Loading Spinner -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 12.0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8.0, 0.0, 0.0, 2.0);" spacing="0.0">
                    <HBox style="-fx-background-color: #f8f9fc; -fx-background-radius: 12.0 12.0 0.0 0.0;">
                        <padding><Insets top="14.0" right="16.0" bottom="14.0" left="16.0" /></padding>
                        <children>
                            <Label text="📋  Upcoming Events" style="-fx-font-weight: bold; -fx-text-fill: #1a1a2e; -fx-font-size: 14.0px;" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnRefreshEvents" onAction="#handleRefreshEvents" style="-fx-background-color: #17a2b8; -fx-background-radius: 5; -fx-text-fill: white; -fx-cursor: hand;" text="⟳ Refresh" />
                        </children>
                    </HBox>

                    <!-- LOADING SPINNER - SIMPLE VERSION -->
                    <HBox fx:id="eventLoadingSpinner" alignment="CENTER" spacing="10" visible="false"
                          style="-fx-padding: 20; -fx-background-color: white;">
                        <ProgressIndicator maxWidth="40" />
                        <Label text="Loading events..." style="-fx-text-fill: #64748b; -fx-font-size: 13px;" />
                    </HBox>

                    <!-- Table View -->
                    <TableView fx:id="eventTable" style="-fx-background-radius: 0.0 0.0 12.0 12.0;"
                               visible="true" managed="true">
                        <columns>
                            <TableColumn fx:id="colTitle" text="Event Name" prefWidth="200.0" />
                            <TableColumn fx:id="colDate" text="Date" prefWidth="120.0" />
                            <TableColumn fx:id="colLocation" text="Location" prefWidth="150.0" />
                            <TableColumn fx:id="colAvailableSeats" text="Available Seats" prefWidth="100.0" />
                            <TableColumn fx:id="colAction" text="Action" prefWidth="100.0" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>