<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group8.csit228capstone.AdminController" style="-fx-background-color: #BDE8F5;">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" padding="20.0">
            <children>
                <Label text="Admin Event Management" textFill="#0f2854">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                <Button fx:id="btnAllBookings" mnemonicParsing="false" onAction="#handleShowAllBookings" style="-fx-background-color: #1C4D8D; -fx-background-radius: 5;" text="All Bookings" textFill="WHITE" />
            </children>
        </HBox>
    </top>
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab fx:id="tabEvents" text="Events">
                    <content>
                        <BorderPane padding="20.0">
                            <left>
                                <VBox spacing="12.0" alignment="TOP_LEFT" BorderPane.alignment="CENTER">
                                    <children>
                                        <Label text="Title" textFill="#0f2854">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="textTitle" />
                                        <Label text="Description" textFill="#0f2854">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="textDescription" />
                                        <Label text="Date" textFill="#0f2854">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="textDate" />
                                        <Label text="Location" textFill="#0f2854">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="textLocation" />
                                        <Label text="Total Seats" textFill="#0f2854">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="textTotalSeats" />
                                        <HBox spacing="10.0" alignment="CENTER">
                                            <children>
                                                <Button fx:id="btnSave" mnemonicParsing="false" onAction="#handleSave" style="-fx-background-color: #1C4D8D; -fx-background-radius: 5;" text="Save" textFill="WHITE" />
                                                <Button fx:id="btnUpdate" mnemonicParsing="false" onAction="#handleUpdate" style="-fx-background-color: #1C4D8D; -fx-background-radius: 5;" text="Update" textFill="WHITE" />
                                                <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#handleDelete" style="-fx-background-color: #1C4D8D; -fx-background-radius: 5;" text="Delete" textFill="WHITE" />
                                                <Button fx:id="btnClear" mnemonicParsing="false" onAction="#handleClear" style="-fx-background-color: #1C4D8D; -fx-background-radius: 5;" text="Clear" textFill="WHITE" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </left>
                            <center>
                                <StackPane fx:id="eventStack">
                                    <children>
                                        <TableView fx:id="tblEvents" prefHeight="320.0" prefWidth="420.0">
                                            <columns>
                                                <TableColumn fx:id="colTitle" text="Title" prefWidth="160.0" />
                                                <TableColumn fx:id="colDate" text="Date" prefWidth="110.0" />
                                                <TableColumn fx:id="colLocation" text="Location" prefWidth="120.0" />
                                                <TableColumn fx:id="colAvailableSeats" text="Available" prefWidth="90.0" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                        <ProgressIndicator fx:id="progressIndicator" maxWidth="80.0" maxHeight="80.0" visible="false" />
                                    </children>
                                </StackPane>
                            </center>
                            <bottom>
                                <Label fx:id="lblEventStatus" text="Ready" textFill="#0f2854" />
                            </bottom>
                        </BorderPane>
                    </content>
                </Tab>
                <Tab fx:id="tabBookings" text="All Bookings">
                    <content>
                        <VBox spacing="12.0" padding="20.0">
                            <children>
                                <HBox spacing="10.0" alignment="CENTER_LEFT">
                                    <children>
                                        <Button fx:id="btnRefreshBookings" mnemonicParsing="false" onAction="#handleRefreshBookings" style="-fx-background-color: #1C4D8D; -fx-background-radius: 5;" text="Refresh" textFill="WHITE" />
                                        <Label fx:id="lblBookingStatus" text="Ready" textFill="#0f2854" />
                                    </children>
                                </HBox>
                                <TableView fx:id="tblBookingsTable" prefHeight="320.0" prefWidth="620.0">
                                    <columns>
                                        <TableColumn fx:id="colCustomerName" text="Customer" prefWidth="140.0" />
                                        <TableColumn fx:id="colBookingEventTitle" text="Event" prefWidth="150.0" />
                                        <TableColumn fx:id="colBookingSeatNumber" text="Seat" prefWidth="100.0" />
                                        <TableColumn fx:id="colBookingDate" text="Booking Date" prefWidth="120.0" />
                                        <TableColumn fx:id="colPaymentStatus" text="Payment Status" prefWidth="120.0" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
