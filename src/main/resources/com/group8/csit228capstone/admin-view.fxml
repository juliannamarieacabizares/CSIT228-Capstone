<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group8.csit228capstone.AdminController" style="-fx-background-color: #f5f7fa;">

    <top>
        <VBox style="-fx-background-color: white;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <children>
                    <Button fx:id="btnBackToDashboard" onAction="#handleBackToDashboard" style="-fx-background-color: transparent; -fx-text-fill: #1a1a2e; -fx-cursor: hand;" text="← Back to Dashboard">
                        <font><Font size="14" /></font>
                    </Button>
                    <Label text="Admin Event Management" textFill="#0f2854">
                        <font>
                            <Font name="System Bold" size="20" />
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                </children>
            </HBox>
            <Separator />
        </VBox>
    </top>

    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- Events Tab -->
                <Tab fx:id="tabEvents" text="Events">
                    <content>
                        <HBox spacing="20" alignment="TOP_CENTER">
                            <children>
                                <!-- Left Panel - Event Form -->
                                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10;" prefWidth="350">
                                    <children>
                                        <Label text="Event Details" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />

                                        <Label text="Title" textFill="#0f2854"><font><Font size="13" /></font></Label>
                                        <TextField fx:id="textTitle" promptText="Event title" />

                                        <Label text="Description" textFill="#0f2854"><font><Font size="13" /></font></Label>
                                        <TextField fx:id="textDescription" promptText="Event description" />

                                        <Label text="Date" textFill="#0f2854"><font><Font size="13" /></font></Label>
                                        <DatePicker fx:id="textDate" promptText="Select event date" />

                                        <Label text="Location" textFill="#0f2854"><font><Font size="13" /></font></Label>
                                        <TextField fx:id="textLocation" promptText="Event location" />

                                        <Label text="Total Seats" textFill="#0f2854"><font><Font size="13" /></font></Label>
                                        <TextField fx:id="textTotalSeats" promptText="Number of seats" />

                                        <Separator />

                                        <Label fx:id="lblEventStatus" text="Ready" textFill="#0f2854" />

                                        <HBox spacing="10" alignment="CENTER">
                                            <children>
                                                <Button fx:id="btnSave" onAction="#handleSave" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5;" text="Save" />
                                                <Button fx:id="btnUpdate" onAction="#handleUpdate" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 5;" text="Update" />
                                                <Button fx:id="btnDelete" onAction="#handleDelete" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-background-radius: 5;" text="Delete" />
                                                <Button fx:id="btnClear" onAction="#handleClear" style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-background-radius: 5;" text="Clear" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Right Panel - Events Table -->
                                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Events List" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                                        <TableView fx:id="tblEvents" prefHeight="400" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colEventId" text="ID" prefWidth="50" />
                                                <TableColumn fx:id="colTitle" text="Title" prefWidth="200" />
                                                <TableColumn fx:id="colDate" text="Date" prefWidth="100" />
                                                <TableColumn fx:id="colLocation" text="Location" prefWidth="150" />
                                                <TableColumn fx:id="colAvailableSeats" text="Available" prefWidth="80" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </content>
                </Tab>

                <!-- All Bookings Tab -->
                <Tab fx:id="tabBookings" text="All Bookings">
                    <content>
                        <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10;">
                            <children>
                                <Label text="All Customer Bookings" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />

                                <TableView fx:id="tblAllBookings" prefHeight="450" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colAllBookingId" text="ID" prefWidth="60" />
                                        <TableColumn fx:id="colAllCustomerName" text="Customer Name" prefWidth="150" />
                                        <TableColumn fx:id="colAllEventTitle" text="Event" prefWidth="200" />
                                        <TableColumn fx:id="colAllSeatNumber" text="Seat" prefWidth="80" />
                                        <TableColumn fx:id="colAllBookingDate" text="Booked On" prefWidth="120" />
                                        <TableColumn fx:id="colAllPaymentStatus" text="Payment" prefWidth="100" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                                <HBox spacing="10" alignment="CENTER_RIGHT">
                                    <children>
                                        <Button fx:id="btnRefreshBookings" onAction="#handleRefreshBookings" style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-background-radius: 5;" text="⟳ Refresh" />
                                        <Label fx:id="lblBookingStatus" text="Ready" textFill="#0f2854" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>