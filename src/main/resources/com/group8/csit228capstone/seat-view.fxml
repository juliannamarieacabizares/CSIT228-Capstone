<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #BDE8F5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group8.csit228capstone.SeatSelectionController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="SELECT YOUR SEATS" textFill="#0f2854">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <Label fx:id="lblEventName" text="Event: " textFill="#0f2854">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <!-- StackPane to hold both spinner and scroll pane (layered) -->
        <StackPane prefHeight="400">
            <!-- Loading Spinner (on top while loading) -->
            <StackPane fx:id="loadingPane" visible="false" prefHeight="400">
                <ProgressIndicator />
            </StackPane>

            <ScrollPane fx:id="scrollPane" fitToWidth="true" prefHeight="400" visible="false" managed="false" style="-fx-background: #BDE8F5; -fx-background-color: #BDE8F5;">
                <GridPane fx:id="seatGrid" alignment="CENTER" hgap="0" vgap="2">
                </GridPane>
            </ScrollPane>
        </StackPane>

        <!-- Selected seats counter -->
        <Label fx:id="textTotal" text="Selected: 0 seat(s)" textFill="#0f2854">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <!-- Legend -->
        <HBox alignment="CENTER" spacing="30.0">
            <children>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button style="-fx-background-color: #4CAF50; -fx-border-radius: 5;" prefWidth="30.0" prefHeight="30.0" text="" />
                        <Label text="Available" textFill="#0f2854">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button style="-fx-background-color: #f44336; -fx-border-radius: 5;" prefWidth="30.0" prefHeight="30.0" text="" />
                        <Label text="Reserved" textFill="#0f2854">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button style="-fx-background-color: #2196F3; -fx-border-radius: 5;" prefWidth="30.0" prefHeight="30.0" text="" />
                        <Label text="Selected" textFill="#0f2854">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>
            </children>
        </HBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button fx:id="btnConfirm" onAction="#handleConfirm" prefWidth="120.0" prefHeight="35.0" style="-fx-background-color: #1C4D8D;" text="CONFIRM" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                <Button fx:id="btnBack" onAction="#handleBack" prefWidth="120.0" prefHeight="35.0" style="-fx-background-color: #607D8B;" text="BACK" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>