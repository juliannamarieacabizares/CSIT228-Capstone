<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group8.csit228capstone.BookingHistoryController">

    <!-- TOP HEADER with Back button -->
    <top>
        <VBox style="-fx-background-color: linear-gradient(to right, #1a1a2e, #16213e);">
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <padding>
                    <Insets top="15.0" right="20.0" bottom="15.0" left="20.0" />
                </padding>
                <children>
                    <Button fx:id="btnBackToDashboard" onAction="#handleBackToDashboard" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="← Back to Dashboard">
                        <font><Font size="13" /></font>
                    </Button>
                    <Label text="📋 My Booking History" textFill="white">
                        <font>
                            <Font name="System Bold" size="18" />
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtSearch" promptText="🔍 Search by event or seat..." prefWidth="220" style="-fx-background-radius: 15; -fx-padding: 8;" />
                </children>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="15.0" alignment="CENTER">
            <padding>
                <Insets top="20.0" right="25.0" bottom="20.0" left="25.0" />
            </padding>
            <children>
                <!-- Stats Summary Card -->
                <HBox spacing="15.0" alignment="CENTER">
                    <children>
                        <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);" spacing="5" HBox.hgrow="ALWAYS">
                            <padding><Insets top="12" right="15" bottom="12" left="15" /></padding>
                            <Label text="🎫" style="-fx-font-size: 24px;" />
                            <Label text="Total Tickets" style="-fx-text-fill: #666; -fx-font-size: 11px;" />
                            <Label fx:id="lblTotalTickets" text="0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                        </VBox>
                        <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);" spacing="5" HBox.hgrow="ALWAYS">
                            <padding><Insets top="12" right="15" bottom="12" left="15" /></padding>
                            <Label text="📅" style="-fx-font-size: 24px;" />
                            <Label text="Upcoming Bookings" style="-fx-text-fill: #666; -fx-font-size: 11px;" />
                            <Label fx:id="lblUpcomingBookings" text="0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;" />
                        </VBox>
                    </children>
                </HBox>

                <!-- Bookings Table -->
                <VBox style="-fx-background-color: white; -fx-background-radius: 12.0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);" spacing="0.0" VBox.vgrow="ALWAYS">
                    <TableView fx:id="tblBookings" style="-fx-background-radius: 0.0 0.0 12.0 12.0;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colBookingId" text="ID" prefWidth="60" />
                            <TableColumn fx:id="colEventTitle" text="Event" prefWidth="200" />
                            <TableColumn fx:id="colEventDate" text="Event Date" prefWidth="120" />
                            <TableColumn fx:id="colSeatNumber" text="Seat" prefWidth="80" />
                            <TableColumn fx:id="colBookingDate" text="Booked On" prefWidth="120" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- Action Buttons -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Label fx:id="lblStatus" text="Ready" textFill="#666" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleCancelBooking" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="🗑 Cancel Selected" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>