<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group8.csit228capstone.BookingHistoryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="My Booking History" textFill="#0f2854">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <TableView fx:id="tblBookings" prefHeight="400.0">
            <columns>
                <TableColumn fx:id="colBookingId" text="Booking ID" prefWidth="80" />
                <TableColumn fx:id="colEventTitle" text="Event" prefWidth="200" />
                <TableColumn fx:id="colEventDate" text="Event Date" prefWidth="120" />
                <TableColumn fx:id="colSeatNumber" text="Seat" prefWidth="80" />
                <TableColumn fx:id="colBookingDate" text="Booked On" prefWidth="120" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <Label fx:id="lblStatus" text="Ready" />

        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button onAction="#handleCancelBooking" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Cancel Selected Booking" />
                <Button onAction="#handleClose" text="Close" />
            </children>
        </HBox>
    </children>
</VBox>