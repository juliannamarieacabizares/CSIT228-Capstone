<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane style="-fx-background-color: linear-gradient(to bottom right, #1a1a2e, #16213e);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.group8.csit228capstone.LoginController">

   <center>
      <VBox alignment="CENTER" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 15;">
         <padding>
            <Insets top="40.0" right="40.0" bottom="40.0" left="40.0" />
         </padding>
         <children>
            <!-- Title Section -->
            <VBox alignment="CENTER" spacing="5">
               <Label text="🎟️" style="-fx-font-size: 48px;" />
               <Label text="Event Ticketing System" textFill="#1a1a2e" wrapText="true" alignment="CENTER">
                  <font>
                     <Font name="System Bold" size="22" />
                  </font>
               </Label>
               <Label text="Book your tickets with ease" textFill="#888888">
                  <font>
                     <Font size="13" />
                  </font>
               </Label>
            </VBox>

            <Separator />

            <!-- Form Fields -->
            <VBox spacing="15" VBox.vgrow="ALWAYS">
               <children>
                  <Label text="Email Address" textFill="#333333">
                     <font><Font size="13" /></font>
                  </Label>
                  <TextField fx:id="textUsername" promptText="Enter your email" style="-fx-background-radius: 8; -fx-padding: 10;" />

                  <Label text="Password" textFill="#333333">
                     <font><Font size="13" /></font>
                  </Label>
                  <PasswordField fx:id="textPassword" promptText="Enter your password" style="-fx-background-radius: 8; -fx-padding: 10;" />

                  <Label fx:id="lblError" text="" textFill="#f44336" style="-fx-font-size: 12px;" wrapText="true" />

                  <Button fx:id="btnSignIn" onAction="#handleLogin" style="-fx-background-color: #1a1a2e; -fx-background-radius: 8; -fx-padding: 10;" text="Sign In" textFill="WHITE">
                     <font><Font size="14" /></font>
                  </Button>

                  <HBox alignment="CENTER" spacing="5">
                     <Label text="Don't have an account?" textFill="#666666" />
                     <Button fx:id="btnRegister" onAction="#handleRegisterNavigation" style="-fx-background-color: transparent; -fx-text-fill: #2196F3; -fx-cursor: hand;" text="Create Account" />
                  </HBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>